{
  "manifest_version": 3,
  "name": "3G's Pool Standings",
  "version": "1.0.1",
  "description": "Scrape a week of CBS Pick'em standings for the 3 G's pool and save it for the analysis pipeline.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "3G's Pool Standings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://picks.cbssports.com/*"
  ]
}
