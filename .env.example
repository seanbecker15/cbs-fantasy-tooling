EMAIL=example@example.com
PASSWORD=your-password
USER_NAME=Your Name
THE_ODDS_API_KEY=your-api-key
WEEK_ONE_START_DATE="2026-09-08"
OUTPUT_DIR="data"
SEASON=2026
# Base32 slug from your CBS pool URL:
# https://picks.cbssports.com/football/pickem/pools/<CBS_POOL_SLUG>/standings/weekly
CBS_POOL_SLUG="your-pool-slug"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
# Completed seasons used to model the field (competitor strategy mix).
# Defaults to OUTPUT_DIR when unset.
HISTORY_DIR="data/2025"
GMAIL_FROM_NAME="3GS Pick'em"   # display name on the weekly email
